{
  "name": "northline-facilities-platform",
  "version": "1.0.0",
  "private": true,
  "description": "Premium facilities management marketing site, client portal, and operations dashboard starter.",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "dev:api": "node --watch backend/src/server.js",
    "build": "vite build",
    "test": "node --test",
    "preview": "vite preview --host 0.0.0.0",
    "start:api": "node backend/src/server.js",
    "prisma:generate": "prisma generate --schema backend/prisma/schema.prisma",
    "db:migrate": "prisma migrate dev --schema backend/prisma/schema.prisma",
    "db:deploy": "prisma migrate deploy --schema backend/prisma/schema.prisma",
    "db:seed": "node backend/prisma/seed.js"
  },
  "dependencies": {
    "@fortawesome/free-brands-svg-icons": "^7.3.1",
    "@prisma/client": "^6.10.1",
    "argon2": "^0.43.0",
    "connect-pg-simple": "^10.0.0",
    "cors": "^2.8.5",
    "dotenv": "^16.5.0",
    "express": "^5.1.0",
    "express-rate-limit": "^7.5.1",
    "express-session": "^1.18.1",
    "helmet": "^8.1.0",
    "pg": "^8.16.3",
    "zod": "^3.25.67"
  },
  "devDependencies": {
    "prisma": "^6.10.1",
    "vite": "^6.3.5"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "overrides": {
    "deepmerge-ts": "^8.0.2"
  }
}
