# Copy to .env locally. Never commit populated secrets.
NODE_ENV=development
PORT=4000
APP_ORIGIN=http://localhost:5173
DATABASE_URL=postgresql://northline_app:change_me@localhost:5432/northline_fm?schema=public
SESSION_SECRET=replace-with-at-least-32-random-bytes
SESSION_COOKIE_NAME=northline.sid
SESSION_SECURE=false
SESSION_SAME_SITE=lax
TRUST_PROXY=0
UPLOAD_DIR=./private-uploads
MAX_UPLOAD_BYTES=10485760
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=Northline Facilities <hello@northlinefm.example>
