generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserStatus {
  ACTIVE
  INVITED
  SUSPENDED
  DEACTIVATED
}

enum PropertyStatus {
  OPERATIONAL
  ATTENTION
  OUT_OF_SERVICE
  INACTIVE
}

enum WorkOrderStatus {
  NEW
  PENDING_REVIEW
  ASSIGNED
  DISPATCHED
  IN_PROGRESS
  ON_HOLD
  WAITING_FOR_PARTS
  COMPLETED
  CLIENT_APPROVAL
  CLOSED
  CANCELLED
}

enum WorkOrderPriority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum TechnicianAvailability {
  AVAILABLE
  BUSY
  ON_BREAK
  OFFLINE
}

enum MaintenanceRecurrence {
  DAILY
  WEEKLY
  MONTHLY
  QUARTERLY
  YEARLY
  CUSTOM
}

enum MaintenanceStatus {
  SCHEDULED
  AT_RISK
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum InvoiceStatus {
  DRAFT
  PENDING
  PAID
  PARTIALLY_PAID
  OVERDUE
  CANCELLED
}

enum OrderStatus {
  DRAFT
  PENDING_APPROVAL
  APPROVED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum PaymentStatus {
  PENDING
  SUCCEEDED
  FAILED
  REFUNDED
  PARTIALLY_REFUNDED
}

enum BlogStatus {
  DRAFT
  SCHEDULED
  PUBLISHED
  ARCHIVED
}

enum NotificationChannel {
  IN_APP
  EMAIL
}

enum MessageThreadStatus {
  OPEN
  CLOSED
}

model Role {
  id          String           @id @default(cuid())
  name        String           @unique @db.VarChar(40)
  description String?          @db.VarChar(240)
  users       User[]
  permissions RolePermission[]
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
}

model Permission {
  id          String           @id @default(cuid())
  key         String           @unique @db.VarChar(80)
  description String?          @db.VarChar(240)
  roles       RolePermission[]
}

model RolePermission {
  roleId       String
  permissionId String
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@index([permissionId])
}

model Company {
  id         String                @id @default(cuid())
  name       String                @db.VarChar(180)
  legalName  String?               @db.VarChar(220)
  domain     String?               @db.VarChar(180)
  phone      String?               @db.VarChar(40)
  status     String                @default("ACTIVE") @db.VarChar(24)
  client     Client?
  users      User[]
  properties Property[]
  workOrders WorkOrder[]
  schedules  MaintenanceSchedule[]
  orders     Order[]
  invoices   Invoice[]
  threads    MessageThread[]
  createdAt  DateTime              @default(now())
  updatedAt  DateTime              @updatedAt
  deletedAt  DateTime?

  @@index([name])
  @@index([status])
}

model Client {
  id               String           @id @default(cuid())
  companyId        String           @unique
  company          Company          @relation(fields: [companyId], references: [id], onDelete: Restrict)
  contractPlan     String           @default("PROFESSIONAL") @db.VarChar(32)
  accountManagerId String?
  accountManager   User?            @relation("ClientAccountManager", fields: [accountManagerId], references: [id], onDelete: SetNull)
  properties       Property[]
  workOrders       WorkOrder[]
  invoices         Invoice[]
  orders           Order[]
  contactRequests  ContactRequest[]
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  deletedAt        DateTime?

  @@index([accountManagerId])
}

model User {
  id                  String                   @id @default(cuid())
  email               String                   @unique @db.VarChar(254)
  passwordHash        String?
  name                String                   @db.VarChar(140)
  phone               String?                  @db.VarChar(40)
  roleId              String
  role                Role                     @relation(fields: [roleId], references: [id], onDelete: Restrict)
  companyId           String?
  company             Company?                 @relation(fields: [companyId], references: [id], onDelete: SetNull)
  status              UserStatus               @default(INVITED)
  emailVerifiedAt     DateTime?
  lastLoginAt         DateTime?
  deactivatedAt       DateTime?
  technicianProfile   Technician?
  managedClients      Client[]                 @relation("ClientAccountManager")
  managedProperties   Property[]               @relation("PropertyManager")
  securityEvents      SecurityEvent[]
  passwordResetTokens PasswordResetToken[]
  verificationTokens  EmailVerificationToken[]
  workOrderEvents     WorkOrderHistory[]
  createdWorkOrders   WorkOrder[]              @relation("WorkOrderCreatedBy")
  assignedWorkOrders  WorkOrder[]              @relation("WorkOrderAssignedTo")
  approvedWorkOrders  WorkOrder[]              @relation("WorkOrderClientApprover")
  comments            WorkOrderComment[]
  uploadedAttachments WorkOrderAttachment[]
  assignedSchedules   MaintenanceSchedule[]    @relation("ScheduleAssignee")
  sentMessages        Message[]
  threadMemberships   MessageParticipant[]
  notifications       Notification[]
  authoredPosts       BlogPost[]
  auditLogs           AuditLog[]
  createdAt           DateTime                 @default(now())
  updatedAt           DateTime                 @updatedAt
  deletedAt           DateTime?

  @@index([companyId, status])
  @@index([roleId, status])
  @@index([name])
}

model Technician {
  id             String                    @id @default(cuid())
  userId         String                    @unique
  user           User                      @relation(fields: [userId], references: [id], onDelete: Cascade)
  availability   TechnicianAvailability    @default(OFFLINE)
  certifications TechnicianCertification[]
  skills         TechnicianSkill[]
  createdAt      DateTime                  @default(now())
  updatedAt      DateTime                  @updatedAt
}

model TechnicianSkill {
  id           String     @id @default(cuid())
  technicianId String
  technician   Technician @relation(fields: [technicianId], references: [id], onDelete: Cascade)
  skill        String     @db.VarChar(100)

  @@unique([technicianId, skill])
  @@index([skill])
}

model TechnicianCertification {
  id            String     @id @default(cuid())
  technicianId  String
  technician    Technician @relation(fields: [technicianId], references: [id], onDelete: Cascade)
  name          String     @db.VarChar(160)
  issuer        String?    @db.VarChar(160)
  credentialRef String?    @db.VarChar(100)
  issuedAt      DateTime?
  expiresAt     DateTime?

  @@index([technicianId, expiresAt])
}

model Property {
  id                String                @id @default(cuid())
  companyId         String
  company           Company               @relation(fields: [companyId], references: [id], onDelete: Restrict)
  clientId          String?
  client            Client?               @relation(fields: [clientId], references: [id], onDelete: SetNull)
  name              String                @db.VarChar(180)
  type              String                @db.VarChar(80)
  addressLine1      String                @db.VarChar(220)
  addressLine2      String?               @db.VarChar(220)
  city              String                @db.VarChar(120)
  region            String?               @db.VarChar(100)
  postalCode        String?               @db.VarChar(24)
  countryCode       String                @default("IN") @db.VarChar(2)
  areaSqFt          Int?
  assignedManagerId String?
  assignedManager   User?                 @relation("PropertyManager", fields: [assignedManagerId], references: [id], onDelete: SetNull)
  status            PropertyStatus        @default(OPERATIONAL)
  deletedAt         DateTime?
  workOrders        WorkOrder[]
  schedules         MaintenanceSchedule[]
  invoices          Invoice[]
  orders            Order[]
  createdAt         DateTime              @default(now())
  updatedAt         DateTime              @updatedAt

  @@index([companyId, status])
  @@index([clientId])
  @@index([name])
}

model ServiceCategory {
  id        String    @id @default(cuid())
  name      String    @unique @db.VarChar(100)
  slug      String    @unique @db.VarChar(120)
  services  Service[]
  createdAt DateTime  @default(now())
}

model Service {
  id          String                @id @default(cuid())
  categoryId  String
  category    ServiceCategory       @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  name        String                @db.VarChar(160)
  slug        String                @unique @db.VarChar(180)
  summary     String                @db.VarChar(320)
  description String?
  isPublished Boolean               @default(true)
  workOrders  WorkOrder[]
  maintenance MaintenanceSchedule[]
  createdAt   DateTime              @default(now())
  updatedAt   DateTime              @updatedAt
  deletedAt   DateTime?

  @@index([categoryId, isPublished])
  @@index([name])
}

model WorkOrder {
  id               String                @id @default(cuid())
  reference        String                @unique @db.VarChar(32)
  companyId        String
  company          Company               @relation(fields: [companyId], references: [id], onDelete: Restrict)
  clientId         String?
  client           Client?               @relation(fields: [clientId], references: [id], onDelete: SetNull)
  propertyId       String
  property         Property              @relation(fields: [propertyId], references: [id], onDelete: Restrict)
  serviceId        String?
  service          Service?              @relation(fields: [serviceId], references: [id], onDelete: SetNull)
  category         String                @db.VarChar(80)
  title            String                @db.VarChar(180)
  description      String                @db.Text
  location         String?               @db.VarChar(180)
  priority         WorkOrderPriority     @default(MEDIUM)
  status           WorkOrderStatus       @default(NEW)
  createdById      String
  createdBy        User                  @relation("WorkOrderCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  assignedToId     String?
  assignedTo       User?                 @relation("WorkOrderAssignedTo", fields: [assignedToId], references: [id], onDelete: SetNull)
  clientApprovedById String?
  clientApprovedBy User?                 @relation("WorkOrderClientApprover", fields: [clientApprovedById], references: [id], onDelete: SetNull)
  completionNote   String?               @db.Text
  estimatedCost    Decimal?              @db.Decimal(12, 2)
  actualCost       Decimal?              @db.Decimal(12, 2)
  currency         String                @default("INR") @db.VarChar(3)
  requestedAt      DateTime              @default(now())
  assignedAt       DateTime?
  acceptedAt       DateTime?
  dispatchedAt     DateTime?
  startedAt        DateTime?
  completedAt      DateTime?
  siteSafetyConfirmedAt DateTime?
  clientApprovedAt DateTime?
  closedAt         DateTime?
  deletedAt        DateTime?
  attachments      WorkOrderAttachment[]
  comments         WorkOrderComment[]
  history          WorkOrderHistory[]
  maintenanceTasks MaintenanceTask[]
  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt

  @@index([companyId, status, requestedAt])
  @@index([companyId, priority, requestedAt])
  @@index([propertyId, status])
  @@index([assignedToId, status])
  @@index([clientId, status])
}

model WorkOrderAttachment {
  id           String    @id @default(cuid())
  workOrderId  String
  workOrder    WorkOrder @relation(fields: [workOrderId], references: [id], onDelete: Cascade)
  uploadedById String
  uploadedBy   User      @relation(fields: [uploadedById], references: [id], onDelete: Restrict)
  storageKey   String    @db.VarChar(300)
  originalName String    @db.VarChar(240)
  mimeType     String    @db.VarChar(120)
  sizeBytes    Int
  sha256       String?   @db.VarChar(64)
  createdAt    DateTime  @default(now())

  @@index([workOrderId, createdAt])
}

model WorkOrderComment {
  id          String    @id @default(cuid())
  workOrderId String
  workOrder   WorkOrder @relation(fields: [workOrderId], references: [id], onDelete: Cascade)
  authorId    String
  author      User      @relation(fields: [authorId], references: [id], onDelete: Restrict)
  body        String    @db.Text
  isInternal  Boolean   @default(false)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([workOrderId, createdAt])
}

model WorkOrderHistory {
  id          String           @id @default(cuid())
  workOrderId String
  workOrder   WorkOrder        @relation(fields: [workOrderId], references: [id], onDelete: Cascade)
  actorId     String?
  actor       User?            @relation(fields: [actorId], references: [id], onDelete: SetNull)
  fromStatus  WorkOrderStatus?
  toStatus    WorkOrderStatus?
  action      String           @db.VarChar(120)
  note        String?          @db.Text
  createdAt   DateTime         @default(now())

  @@index([workOrderId, createdAt])
}

model MaintenanceSchedule {
  id           String                @id @default(cuid())
  companyId    String
  company      Company               @relation(fields: [companyId], references: [id], onDelete: Restrict)
  propertyId   String
  property     Property              @relation(fields: [propertyId], references: [id], onDelete: Restrict)
  serviceId    String?
  service      Service?              @relation(fields: [serviceId], references: [id], onDelete: SetNull)
  title        String                @db.VarChar(180)
  recurrence   MaintenanceRecurrence @default(MONTHLY)
  nextDueAt    DateTime
  timezone     String                @default("Asia/Kolkata") @db.VarChar(80)
  reminderDays Int                   @default(3)
  assignedToId String?
  assignedTo   User?                 @relation("ScheduleAssignee", fields: [assignedToId], references: [id], onDelete: SetNull)
  status       MaintenanceStatus     @default(SCHEDULED)
  notes        String?               @db.Text
  tasks        MaintenanceTask[]
  createdAt    DateTime              @default(now())
  updatedAt    DateTime              @updatedAt
  deletedAt    DateTime?

  @@index([companyId, nextDueAt, status])
  @@index([propertyId, nextDueAt])
}

model MaintenanceTask {
  id          String              @id @default(cuid())
  scheduleId  String
  schedule    MaintenanceSchedule @relation(fields: [scheduleId], references: [id], onDelete: Cascade)
  workOrderId String?
  workOrder   WorkOrder?          @relation(fields: [workOrderId], references: [id], onDelete: SetNull)
  dueAt       DateTime
  completedAt DateTime?
  status      MaintenanceStatus   @default(SCHEDULED)
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt

  @@index([scheduleId, dueAt])
  @@index([workOrderId])
}

model Order {
  id          String      @id @default(cuid())
  reference   String      @unique @db.VarChar(32)
  companyId   String
  company     Company     @relation(fields: [companyId], references: [id], onDelete: Restrict)
  clientId    String?
  client      Client?     @relation(fields: [clientId], references: [id], onDelete: SetNull)
  propertyId  String?
  property    Property?   @relation(fields: [propertyId], references: [id], onDelete: SetNull)
  status      OrderStatus @default(DRAFT)
  description String?     @db.Text
  quotedTotal Decimal?    @db.Decimal(12, 2)
  currency    String      @default("INR") @db.VarChar(3)
  approvedAt  DateTime?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  deletedAt   DateTime?

  @@index([companyId, status, createdAt])
  @@index([clientId])
}

model Invoice {
  id             String        @id @default(cuid())
  reference      String        @unique @db.VarChar(32)
  companyId      String
  company        Company       @relation(fields: [companyId], references: [id], onDelete: Restrict)
  clientId       String?
  client         Client?       @relation(fields: [clientId], references: [id], onDelete: SetNull)
  propertyId     String?
  property       Property?     @relation(fields: [propertyId], references: [id], onDelete: SetNull)
  status         InvoiceStatus @default(DRAFT)
  amountSubtotal Decimal       @db.Decimal(12, 2)
  amountTax      Decimal       @default(0) @db.Decimal(12, 2)
  amountTotal    Decimal       @db.Decimal(12, 2)
  currency       String        @default("INR") @db.VarChar(3)
  issuedAt       DateTime?
  dueAt          DateTime?
  paidAt         DateTime?
  pdfStorageKey  String?       @db.VarChar(300)
  payments       Payment[]
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  deletedAt      DateTime?

  @@index([companyId, status, dueAt])
  @@index([clientId, status])
}

model Payment {
  id                String        @id @default(cuid())
  invoiceId         String
  invoice           Invoice       @relation(fields: [invoiceId], references: [id], onDelete: Restrict)
  provider          String        @db.VarChar(50)
  providerPaymentId String?       @unique @db.VarChar(180)
  amount            Decimal       @db.Decimal(12, 2)
  currency          String        @default("INR") @db.VarChar(3)
  status            PaymentStatus @default(PENDING)
  paidAt            DateTime?
  refundedAt        DateTime?
  createdAt         DateTime      @default(now())

  @@index([invoiceId, status])
}

model MessageThread {
  id        String               @id @default(cuid())
  companyId String
  company   Company              @relation(fields: [companyId], references: [id], onDelete: Restrict)
  subject   String               @db.VarChar(180)
  status    MessageThreadStatus  @default(OPEN)
  messages  Message[]
  members   MessageParticipant[]
  createdAt DateTime             @default(now())
  updatedAt DateTime             @updatedAt

  @@index([companyId, status, updatedAt])
}

model MessageParticipant {
  threadId   String
  userId     String
  thread     MessageThread @relation(fields: [threadId], references: [id], onDelete: Cascade)
  user       User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  lastReadAt DateTime?

  @@id([threadId, userId])
  @@index([userId, lastReadAt])
}

model Message {
  id          String              @id @default(cuid())
  threadId    String
  thread      MessageThread       @relation(fields: [threadId], references: [id], onDelete: Cascade)
  senderId    String
  sender      User                @relation(fields: [senderId], references: [id], onDelete: Restrict)
  body        String              @db.Text
  sentAt      DateTime            @default(now())
  editedAt    DateTime?
  attachments MessageAttachment[]

  @@index([threadId, sentAt])
}

model MessageAttachment {
  id           String   @id @default(cuid())
  messageId    String
  message      Message  @relation(fields: [messageId], references: [id], onDelete: Cascade)
  storageKey   String   @db.VarChar(300)
  originalName String   @db.VarChar(240)
  mimeType     String   @db.VarChar(120)
  sizeBytes    Int
  createdAt    DateTime @default(now())
}

model Notification {
  id        String              @id @default(cuid())
  userId    String
  user      User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String              @db.VarChar(180)
  body      String              @db.VarChar(600)
  channel   NotificationChannel @default(IN_APP)
  readAt    DateTime?
  data      Json?
  createdAt DateTime            @default(now())

  @@index([userId, readAt, createdAt])
}

model BlogPost {
  id               String        @id @default(cuid())
  slug             String        @unique @db.VarChar(180)
  title            String        @db.VarChar(220)
  excerpt          String        @db.VarChar(500)
  body             String        @db.Text
  status           BlogStatus    @default(DRAFT)
  authorId         String?
  author           User?         @relation(fields: [authorId], references: [id], onDelete: SetNull)
  categoryId       String?
  category         BlogCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  tags             BlogPostTag[]
  featuredImageKey String?       @db.VarChar(300)
  metaTitle        String?       @db.VarChar(220)
  metaDescription  String?       @db.VarChar(320)
  canonicalUrl     String?       @db.VarChar(500)
  ogImageKey       String?       @db.VarChar(300)
  scheduledAt      DateTime?
  publishedAt      DateTime?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
  deletedAt        DateTime?

  @@index([status, publishedAt])
  @@index([categoryId])
}

model BlogCategory {
  id        String     @id @default(cuid())
  name      String     @unique @db.VarChar(100)
  slug      String     @unique @db.VarChar(120)
  posts     BlogPost[]
  createdAt DateTime   @default(now())
}

model BlogTag {
  id    String        @id @default(cuid())
  name  String        @unique @db.VarChar(80)
  slug  String        @unique @db.VarChar(100)
  posts BlogPostTag[]
}

model BlogPostTag {
  postId String
  tagId  String
  post   BlogPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  tag    BlogTag  @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([postId, tagId])
  @@index([tagId])
}

model Testimonial {
  id          String   @id @default(cuid())
  clientName  String   @db.VarChar(140)
  role        String   @db.VarChar(160)
  companyName String   @db.VarChar(180)
  quote       String   @db.Text
  rating      Int      @default(5)
  imageKey    String?  @db.VarChar(300)
  isPublished Boolean  @default(false)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([isPublished, sortOrder])
}

model ContactRequest {
  id           String   @id @default(cuid())
  clientId     String?
  client       Client?  @relation(fields: [clientId], references: [id], onDelete: SetNull)
  name         String   @db.VarChar(140)
  companyName  String?  @db.VarChar(180)
  email        String   @db.VarChar(254)
  phone        String?  @db.VarChar(40)
  service      String?  @db.VarChar(120)
  propertyType String?  @db.VarChar(100)
  message      String   @db.Text
  status       String   @default("NEW") @db.VarChar(24)
  createdAt    DateTime @default(now())

  @@index([status, createdAt])
  @@index([email])
}

model AuditLog {
  id         String   @id @default(cuid())
  actorId    String?
  actor      User?    @relation(fields: [actorId], references: [id], onDelete: SetNull)
  action     String   @db.VarChar(120)
  entityType String   @db.VarChar(100)
  entityId   String?  @db.VarChar(100)
  result     String   @default("SUCCESS") @db.VarChar(24)
  ipAddress  String?  @db.VarChar(45)
  metadata   Json?
  createdAt  DateTime @default(now())

  @@index([actorId, createdAt])
  @@index([entityType, entityId, createdAt])
  @@index([action, createdAt])
}

// connect-pg-simple uses this PostgreSQL session table. Keep columns compatible with its store.
model Session {
  sid    String   @id @db.VarChar(255)
  sess   Json
  expire DateTime @db.Timestamp(6)

  @@index([expire])
  @@map("session")
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique @db.VarChar(64)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, expiresAt])
}

model EmailVerificationToken {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique @db.VarChar(64)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, expiresAt])
}

model SecurityEvent {
  id        String   @id @default(cuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  eventType String   @db.VarChar(80)
  result    String   @db.VarChar(32)
  ipAddress String?  @db.VarChar(45)
  userAgent String?  @db.VarChar(300)
  createdAt DateTime @default(now())

  @@index([eventType, createdAt])
  @@index([userId, createdAt])
}
